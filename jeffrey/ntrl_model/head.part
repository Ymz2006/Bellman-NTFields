<title>ntrl-demo Metric Network</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700&family=IBM+Plex+Sans:wght@400;600&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
/* Layout: one reading column; the diagram breaks wider and scrolls sideways on phones. */
:root{
  --bg:#f4f6f8; --panel:#ffffff; --fg:#18202b; --muted:#566273; --line:#c3ccd7; --soft:#e7ebf0;
  --start:#1d6aa8; --goal:#b85e17; --mod:#6a4ca3; --fixed:#8b96a5;
  --display:"Archivo","Helvetica Neue",Arial,sans-serif;
  --body:"IBM Plex Sans","Segoe UI",Roboto,Arial,sans-serif;
  --mono:"IBM Plex Mono",ui-monospace,"SFMono-Regular",Menlo,Consolas,monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#11151b; --panel:#1a2029; --fg:#e3e8ee; --muted:#9aa6b5; --line:#3a4656; --soft:#232b36;
  --start:#5ea9e8; --goal:#f0a25b; --mod:#a98ce6; --fixed:#7d8898; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#11151b; --panel:#1a2029; --fg:#e3e8ee; --muted:#9aa6b5; --line:#3a4656; --soft:#232b36;
  --start:#5ea9e8; --goal:#f0a25b; --mod:#a98ce6; --fixed:#7d8898; color-scheme:dark}
body{background:var(--bg);color:var(--fg);font:15px/1.6 var(--body)}
.wrap{max-width:1180px;margin:0 auto;padding-block:40px 64px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));display:grid;gap:40px}
.read{max-width:760px;display:grid;gap:14px;min-width:0}
.eyebrow{font:500 12.5px var(--mono);color:var(--muted);letter-spacing:.02em}
h1{font:700 clamp(28px,4.4vw,40px)/1.1 var(--display);margin:0;text-wrap:balance;letter-spacing:-.01em}
h2{font:700 21px/1.25 var(--display);margin:0;text-wrap:balance}
p{margin:0}
code,.m{font-family:var(--mono);font-size:.92em}
.facts{display:flex;flex-wrap:wrap;gap:10px 28px;margin:4px 0 0;padding:14px 0;border-block:1px solid var(--line)}
.facts div{display:grid;gap:2px}
.facts dt{font:500 11.5px var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.facts dd{margin:0;font:600 15px var(--body);font-variant-numeric:tabular-nums}
figure{margin:0;display:grid;gap:12px;min-width:0}
.legend{display:flex;flex-wrap:wrap;gap:8px 20px;font-size:13px;color:var(--muted)}
.legend span{display:inline-flex;align-items:center;gap:8px}
.sw{width:22px;height:12px;border-radius:2px;border:2px solid currentColor;display:inline-block}
.scroll{overflow-x:auto;background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:18px 12px}
.scroll svg{display:block;width:100%;min-width:900px;height:auto;color:var(--fg)}
figcaption{font-size:13.5px;color:var(--muted);max-width:760px}
/* svg parts */
svg text{fill:var(--fg);font-family:var(--body);font-size:13px}
svg .b{font-weight:600}
svg .mono{font-family:var(--mono);font-size:11.5px}
svg .sm{font-size:11.5px;fill:var(--muted)}
svg .an{font-size:12px;fill:var(--muted)}
svg .anh{font-size:12.5px;font-weight:600;fill:var(--fg)}
svg .big{font-family:var(--display);font-size:24px;font-weight:700}
svg .box{fill:var(--panel);stroke:var(--line);stroke-width:1.3}
svg .op{fill:var(--soft);stroke:var(--line);stroke-width:1.3}
svg .cont{fill:none;stroke:var(--line);stroke-width:1.2;stroke-dasharray:5 4}
svg .nop{fill:var(--panel);stroke:var(--fixed);stroke-width:1.3;stroke-dasharray:4 3}
svg .hatch{fill:url(#hatch)}
svg .hl{stroke:var(--fixed);stroke-width:1}
svg .s0{fill:var(--panel);stroke:var(--start);stroke-width:2}
svg .s1{fill:var(--panel);stroke:var(--goal);stroke-width:2}
svg .gate{fill:var(--panel);stroke:var(--mod);stroke-width:2}
svg .ar{fill:none;stroke:var(--fg);stroke-width:1.4}
svg .ar0{fill:none;stroke:var(--start);stroke-width:1.8}
svg .ar1{fill:none;stroke:var(--goal);stroke-width:1.8}
svg .bus{fill:none;stroke:var(--mod);stroke-width:2.2}
svg .skip{fill:none;stroke:var(--muted);stroke-width:1.4}
svg .mk{fill:var(--fg)} svg .mk0{fill:var(--start)} svg .mk1{fill:var(--goal)} svg .mkm{fill:var(--mod)} svg .mks{fill:var(--muted)}
svg .t0{fill:var(--start)} svg .t1{fill:var(--goal)} svg .tm{fill:var(--mod)}
svg .cellp{fill:var(--panel);stroke:var(--line);stroke-width:.6}
svg .hi{fill:var(--start)}
svg .div{stroke:var(--line);stroke-width:1}
/* tables and lists */
.tbl{overflow-x:auto;min-width:0}
table{border-collapse:collapse;width:100%;font-size:14px;font-variant-numeric:tabular-nums}
th,td{text-align:left;padding:8px 12px 8px 0;border-bottom:1px solid var(--line);vertical-align:top}
th{font:500 11.5px var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
td.n{text-align:right;font-family:var(--mono);font-size:13px;white-space:nowrap}
th.n{text-align:right}
tr.tot td{font-weight:600;border-bottom:none}
.muted{color:var(--muted)}
.terms{display:grid;gap:14px;margin:0;padding:0;list-style:none}
.terms li{display:grid;gap:4px;padding-left:14px;border-left:3px solid var(--line)}
.terms .w{font:500 12px var(--mono);color:var(--muted)}
.eq{font-family:var(--mono);font-size:13.5px;background:var(--soft);padding:2px 6px;border-radius:4px;overflow-wrap:anywhere}
ol.why{margin:0;padding-left:22px;display:grid;gap:10px}
.cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:40px;align-items:start}
.cols > section{display:grid;gap:14px;min-width:0}
</style>
