<svg viewBox="0 0 1120 1200" role="img" aria-label="ntrl-demo metric network: start and goal pass through one shared encoder (fixed Fourier features, a modulation pair u and v, two gated blocks, a final linear layer and a per-row normalisation) to 256-number embeddings; T is 0.2 times the sum over 16 groups of the soft maximum of the absolute embedding differences, and speed is 1 over the gradient of T.">
<defs>
  <marker id="a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="mk" d="M0,0 L10,5 L0,10 z"/></marker>
  <marker id="a0" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="mk0" d="M0,0 L10,5 L0,10 z"/></marker>
  <marker id="a1" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="mk1" d="M0,0 L10,5 L0,10 z"/></marker>
  <marker id="am" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path class="mkm" d="M0,0 L10,5 L0,10 z"/></marker>
  <marker id="as" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path class="mks" d="M0,0 L10,5 L0,10 z"/></marker>
  <pattern id="hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><line class="hl" x1="0" y1="0" x2="0" y2="7"/></pattern>
  <pattern id="cell" x="302" y="1040" width="6" height="6" patternUnits="userSpaceOnUse"><rect class="cellp" width="6" height="6"/></pattern>
</defs>

<!-- right-hand annotation column divider -->
<line class="div" x1="622" y1="10" x2="622" y2="960"/>

<!-- inputs -->
<rect class="s0" x="220" y="16" width="165" height="46" rx="5"/>
<text class="b t0" x="302" y="36" text-anchor="middle">x₀  start</text>
<text class="mono" x="302" y="53" text-anchor="middle">N × d</text>
<rect class="s1" x="405" y="16" width="165" height="46" rx="5"/>
<text class="b t1" x="487" y="36" text-anchor="middle">x₁  goal</text>
<text class="mono" x="487" y="53" text-anchor="middle">N × d</text>
<path class="ar0" d="M302,62 V90" marker-end="url(#a0)"/>
<path class="ar1" d="M487,62 V90" marker-end="url(#a1)"/>
<text class="anh" x="640" y="32">Inputs</text>
<text class="an" x="640" y="50">d = 3 in the maze (x, y, heading) · d = 6 for the arm (joint angles)</text>

<!-- stack -->
<rect class="op" x="220" y="92" width="350" height="36" rx="5"/>
<text x="395" y="115" text-anchor="middle"><tspan class="b">stack rows</tspan><tspan class="mono">   2N × d</tspan></text>
<path class="ar" d="M395,128 V148" marker-end="url(#a)"/>
<text class="anh" x="640" y="106">One encoder for both ends</text>
<text class="an" x="640" y="124">Start and goal rows are stacked, encoded with the same weights,</text>
<text class="an" x="640" y="140">and split again after the normalisation.</text>

<!-- fourier -->
<rect class="nop" x="220" y="150" width="350" height="64" rx="5"/>
<rect class="hatch" x="221" y="151" width="22" height="62"/>
<text class="b" x="405" y="171" text-anchor="middle">Fourier features γ(x)</text>
<text class="mono" x="405" y="189" text-anchor="middle">[ sin 2π·x·Bᵀ , cos 2π·x·Bᵀ ]</text>
<text class="mono sm" x="405" y="206" text-anchor="middle">2N × d  →  2N × 256</text>
<text class="anh" x="640" y="168">Fixed frequencies (hatched = not trained)</text>
<text class="an" x="640" y="186">B is 128 × d, drawn once at the start and saved with the model.</text>
<text class="an" x="640" y="202">metric: N(0, 1) truncated to ±2 · metric_arm: 0.2 · N(0, 1)</text>
<text class="an" x="640" y="218">These 128 directions and frequencies are the only ones the input offers.</text>

<!-- branch to gate pair -->
<path class="ar" d="M220,182 H95 V238" marker-end="url(#a)"/>
<text class="mono" x="150" y="176" text-anchor="middle">γ</text>
<path class="ar" d="M395,214 V260" marker-end="url(#a)"/>
<text class="mono sm" x="402" y="226">γ</text>

<!-- gate pair -->
<rect class="gate" x="20" y="240" width="150" height="86" rx="5"/>
<text class="b tm" x="95" y="259" text-anchor="middle">modulation pair</text>
<text class="mono" x="95" y="279" text-anchor="middle">u = sin(W_u γ + b)</text>
<text class="mono" x="95" y="296" text-anchor="middle">v = sin(W_v γ + b)</text>
<text class="sm" x="95" y="316" text-anchor="middle">256→256 each · Lip</text>
<!-- bus -->
<path class="bus" d="M170,283 H192 V620"/>
<text class="mono tm" x="182" y="470" text-anchor="middle" transform="rotate(-90 182 470)">u, v  →  every M layer</text>
<path class="bus" d="M192,286 H218" marker-end="url(#am)"/>
<path class="bus" d="M192,350 H218" marker-end="url(#am)"/>
<path class="bus" d="M192,556 H218" marker-end="url(#am)"/>
<path class="bus" d="M192,620 H218" marker-end="url(#am)"/>
<text class="anh" x="640" y="252">Modulation pair (left)</text>
<text class="an" x="640" y="270">u and v come straight from γ and are reused by all four M layers,</text>
<text class="an" x="640" y="286">so the Fourier features re-enter the network by multiplication.</text>
<text class="mono an" x="640" y="303">2 × 65,792 params</text>

<!-- block 1 -->
<rect class="cont" x="206" y="230" width="396" height="252" rx="8"/>
<text class="sm b" x="214" y="248">block 1</text>
<path class="skip" d="M395,246 H585 V458 H408" marker-end="url(#as)"/>
<text class="mono sm" x="590" y="356">x_in</text>
<rect class="box" x="220" y="262" width="350" height="48" rx="5"/>
<text x="395" y="281" text-anchor="middle"><tspan class="b">M</tspan>  Linear 256→256 · Lip  →  y</text>
<text class="mono" x="395" y="300" text-anchor="middle">x = u·sin y + v·(1 − sin y)</text>
<path class="ar" d="M395,310 V324" marker-end="url(#a)"/>
<rect class="box" x="220" y="326" width="350" height="48" rx="5"/>
<text x="395" y="345" text-anchor="middle"><tspan class="b">M</tspan>  Linear 256→256 · Lip  →  y</text>
<text class="mono" x="395" y="364" text-anchor="middle">x = u·sin y + v·(1 − sin y)</text>
<path class="ar" d="M395,374 V388" marker-end="url(#a)"/>
<rect class="box" x="220" y="390" width="350" height="36" rx="5"/>
<text x="395" y="413" text-anchor="middle">Linear 256→256 · Lip  →  sin y</text>
<path class="ar" d="M395,426 V445" marker-end="url(#a)"/>
<circle class="op" cx="395" cy="458" r="11"/>
<text class="b" x="395" y="462.5" text-anchor="middle">g</text>
<text class="anh" x="640" y="340">Block 1 (block 2 has the same layout)</text>
<text class="an" x="640" y="358">M layer: y = Wx + b, then x = v + (u − v)·sin y.</text>
<text class="an" x="640" y="374">Third layer: sin y, then a learned mix with the block's input:</text>
<text class="mono an" x="656" y="392">x ← (1 − g)·x_in + g·sin y,  g = σ(0.1·w)</text>
<text class="an" x="640" y="410">w starts at 0, so g starts at 0.5.</text>
<text class="mono an" x="640" y="428">3 × 65,792 params + 1 gate weight</text>

<!-- block 2 -->
<path class="ar" d="M395,469 V530" marker-end="url(#a)"/>
<rect class="cont" x="206" y="500" width="396" height="252" rx="8"/>
<text class="sm b" x="214" y="518">block 2</text>
<path class="skip" d="M395,516 H585 V728 H408" marker-end="url(#as)"/>
<text class="mono sm" x="590" y="626">x_in</text>
<rect class="box" x="220" y="532" width="350" height="48" rx="5"/>
<text x="395" y="551" text-anchor="middle"><tspan class="b">M</tspan>  Linear 256→256 · Lip  →  y</text>
<text class="mono" x="395" y="570" text-anchor="middle">x = u·sin y + v·(1 − sin y)</text>
<path class="ar" d="M395,580 V594" marker-end="url(#a)"/>
<rect class="box" x="220" y="596" width="350" height="48" rx="5"/>
<text x="395" y="615" text-anchor="middle"><tspan class="b">M</tspan>  Linear 256→256 · Lip  →  y</text>
<text class="mono" x="395" y="634" text-anchor="middle">x = u·sin y + v·(1 − sin y)</text>
<path class="ar" d="M395,644 V658" marker-end="url(#a)"/>
<rect class="box" x="220" y="660" width="350" height="36" rx="5"/>
<text x="395" y="683" text-anchor="middle">Linear 256→256 · Lip  →  sin y</text>
<path class="ar" d="M395,696 V715" marker-end="url(#a)"/>
<circle class="op" cx="395" cy="728" r="11"/>
<text class="b" x="395" y="732.5" text-anchor="middle">g</text>
<text class="anh" x="640" y="520">Lip: Lipschitz clamp on every linear layer</text>
<text class="an" x="640" y="538">Before each use, every weight row is rescaled:</text>
<text class="mono an" x="656" y="556">w_row · (1 + 10⁻⁵ − softplus₁₀(1 − 1/‖w_row‖))</text>
<text class="an" x="640" y="574">Rows with norm ≤ 1 pass almost unchanged; longer rows are pulled</text>
<text class="an" x="640" y="590">back to norm ≈ 1. Each layer stays smooth, so sharp changes have</text>
<text class="an" x="640" y="606">to come from B's frequencies and the u·sin y products.</text>
<text class="mono an" x="640" y="630">block 2: 3 × 65,792 params + 1 gate weight</text>

<!-- final + norm -->
<path class="ar" d="M395,739 V774" marker-end="url(#a)"/>
<rect class="box" x="220" y="776" width="350" height="36" rx="5"/>
<text x="395" y="799" text-anchor="middle">Linear 256→256 · Lip</text>
<path class="ar" d="M395,812 V830" marker-end="url(#a)"/>
<rect class="nop" x="220" y="832" width="350" height="44" rx="5"/>
<text class="b" x="395" y="850" text-anchor="middle">InstanceNorm, per row</text>
<text class="mono sm" x="395" y="867" text-anchor="middle">each 256-vector → mean 0, variance 1 · no scale or shift</text>
<path class="ar0" d="M395,876 V890 H302 V904" marker-end="url(#a0)"/>
<path class="ar1" d="M395,890 H487 V904" marker-end="url(#a1)"/>
<rect class="s0" x="220" y="906" width="165" height="44" rx="5"/>
<text class="b t0" x="302" y="926" text-anchor="middle">φ(x₀)</text>
<text class="mono" x="302" y="942" text-anchor="middle">N × 256</text>
<rect class="s1" x="405" y="906" width="165" height="44" rx="5"/>
<text class="b t1" x="487" y="926" text-anchor="middle">φ(x₁)</text>
<text class="mono" x="487" y="942" text-anchor="middle">N × 256</text>
<text class="anh" x="640" y="792">Embedding</text>
<text class="an" x="640" y="810">Final linear layer: 65,792 params. The norm has none.</text>
<text class="an" x="640" y="826">Every embedding ends up the same size (sum of squares = 256),</text>
<text class="an" x="640" y="842">so T and |∇T| are bounded: there is a slowest speed the field</text>
<text class="an" x="640" y="858">can show, which is the speed it needs right next to an obstacle.</text>
<text class="anh" x="640" y="918">Output head (below): no trainable weights</text>
<text class="an" x="640" y="936">T is built from the two embeddings by fixed arithmetic.</text>

<!-- to head -->
<path class="ar0" d="M302,950 V968 H90 V1008" marker-end="url(#a0)"/>
<path class="ar1" d="M487,950 V982 H150 V1008" marker-end="url(#a1)"/>

<!-- head boxes -->
<rect class="box" x="20" y="1010" width="200" height="150" rx="5"/>
<text class="b" x="120" y="1036" text-anchor="middle">|φ(x₀) − φ(x₁)|</text>
<text class="mono" x="120" y="1060" text-anchor="middle">√(Δ² + 10⁻⁶)</text>
<text class="sm" x="120" y="1078" text-anchor="middle">per dimension</text>
<text class="mono" x="120" y="1150" text-anchor="middle">N × 256</text>
<path class="ar" d="M220,1085 H253" marker-end="url(#a)"/>

<rect class="box" x="255" y="1010" width="190" height="150" rx="5"/>
<text class="b" x="350" y="1031" text-anchor="middle">16 groups × 16 dims</text>
<rect x="302" y="1040" width="96" height="96" fill="url(#cell)"/>
<rect class="hi" x="320" y="1040" width="6" height="6"/><rect class="hi" x="368" y="1046" width="6" height="6"/><rect class="hi" x="344" y="1052" width="6" height="6"/><rect class="hi" x="302" y="1058" width="6" height="6"/><rect class="hi" x="386" y="1064" width="6" height="6"/><rect class="hi" x="332" y="1070" width="6" height="6"/><rect class="hi" x="356" y="1076" width="6" height="6"/><rect class="hi" x="314" y="1082" width="6" height="6"/><rect class="hi" x="374" y="1088" width="6" height="6"/><rect class="hi" x="338" y="1094" width="6" height="6"/><rect class="hi" x="392" y="1100" width="6" height="6"/><rect class="hi" x="308" y="1106" width="6" height="6"/><rect class="hi" x="350" y="1112" width="6" height="6"/><rect class="hi" x="362" y="1118" width="6" height="6"/><rect class="hi" x="326" y="1124" width="6" height="6"/><rect class="hi" x="380" y="1130" width="6" height="6"/>
<text class="mono" x="350" y="1152" text-anchor="middle">N × 16 × 16</text>
<path class="ar" d="M445,1085 H478" marker-end="url(#a)"/>

<rect class="box" x="480" y="1010" width="220" height="150" rx="5"/>
<text class="b" x="590" y="1036" text-anchor="middle">soft max in each group</text>
<text class="mono" x="590" y="1062" text-anchor="middle">(logsumexp(10·d) − ln 16)/10</text>
<text class="sm" x="590" y="1084" text-anchor="middle">≈ the largest gap in the group</text>
<text class="sm" x="590" y="1100" text-anchor="middle">(a soft max-norm distance)</text>
<text class="mono" x="590" y="1150" text-anchor="middle">N × 16</text>
<path class="ar" d="M700,1085 H733" marker-end="url(#a)"/>

<rect class="box" x="735" y="1010" width="150" height="150" rx="5"/>
<text class="b" x="810" y="1036" text-anchor="middle">sum × 0.2</text>
<text class="sm" x="810" y="1054" text-anchor="middle">(× 0.1 in metric_arm)</text>
<text class="big" x="810" y="1100" text-anchor="middle">T</text>
<text class="mono" x="810" y="1150" text-anchor="middle">N × 1</text>
<path class="ar" d="M885,1085 H918" marker-end="url(#a)"/>

<rect class="op" x="920" y="1010" width="190" height="150" rx="5"/>
<text class="b" x="1015" y="1036" text-anchor="middle">autograd</text>
<text class="mono" x="1015" y="1060" text-anchor="middle">∇ₓ₀T ,  ∇ₓ₁T</text>
<text class="mono" x="1015" y="1084" text-anchor="middle">S = 1 / |∇T|</text>
<text class="sm" x="1015" y="1108" text-anchor="middle">the planner moves x₀</text>
<text class="sm" x="1015" y="1124" text-anchor="middle">along −∇ₓ₀T</text>
<text class="mono" x="1015" y="1150" text-anchor="middle">N × d each</text>

<text class="sm" x="590" y="1186" text-anchor="middle">T(x, x) ≈ 0.003, not exactly 0</text>
<text class="sm" x="810" y="1186" text-anchor="middle">symmetric in x₀ and x₁</text>
<text class="sm" x="350" y="1186" text-anchor="middle">filled cell = each group's largest gap</text>
</svg>
